# AutoNOC environment variables (roadmap item — was missing).
# Copy to .env or export in your shell. The API reads these at boot.

# Simulation seed (the "Storm over Goizha" demo uses 131)
AUTONOC_SEED=42

# 1 = auto-enable the Commander at boot
AUTONOC_AI=0

# Auto-approve Commander actions after N wall-clock seconds (demo mode; 0 = off)
AUTONOC_AUTO_APPROVE=0

# Where completed-run summaries are stored (Fly mounts its volume at /data)
# AUTONOC_DATA_DIR=./data

# ---------------------------------------------------------------- sessions
# Each browser gets its own engine, so capacity bounds how many engines run.
# Only /api/* traffic takes a slot; probes, crawlers and assets never do.
# See docs/SESSION_CAPACITY_FIX.md for the sizing notes behind these defaults.

# Hard cap on concurrent dashboards.
AUTONOC_MAX_SESSIONS=16

# Seconds without a request before a dashboard is dropped.
AUTONOC_SESSION_IDLE_SECONDS=180

# How long a dashboard must be silent before its slot may be given to a new
# visitor. A dashboard that is still polling is never evicted first.
AUTONOC_SESSION_RECLAIM_GRACE=15

# 0 = a full registry refuses new visitors instead of reclaiming a quiet slot.
# The dashboard's retry (X-AutoNOC-Retry) still adopts the oldest session.
AUTONOC_SESSION_RECLAIM=1

# Secure cookie flag: auto (follow the request scheme), 1 or 0.
AUTONOC_COOKIE_SECURE=auto
